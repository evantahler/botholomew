# Copy to `.env` for local development: `cp .env.example .env`
#
# Keryx's `loadFromEnvIfSet` checks `${VAR}_${NODE_ENV}` before `${VAR}`, so the
# `_TEST` variants below select themselves automatically when `bun test` sets
# `NODE_ENV=test`. One file covers both development and test.
#
# The Playwright suite is a test process too — `frontend/playwright.config.ts`
# starts the backend with `NODE_ENV=test`, so it reads the same `_TEST` values
# below and lands in the same test database `bun test` uses. What it overrides is
# only what a browser-driven suite needs differently: fixed ports (a browser
# cannot be told a random one), request logging, and the rate limiter. That file
# is where those live.
#
# The values below are right for a single clone. Several checkouts of this repo
# would all point at one `botholomew_test`, and since every suite opens with
# `clearDatabase()` they truncate each other mid-run. `bun run workspace:setup`
# is the optional fix: it rewrites `DATABASE_URL_TEST` and `REDIS_URL_TEST` below
# to this checkout's own, creates the databases, and pins the id it chose as
# `BOTHOLOMEW_WORKSPACE_ID`. Nothing on the server derives any of that — what is
# in this file is what runs.

NODE_ENV=development
PROCESS_NAME=botholomew-api
PROCESS_NAME_TEST=botholomew-test
PROCESS_SHUTDOWN_TIMEOUT=30000

LOG_LEVEL=info
LOG_LEVEL_TEST=fatal
LOG_INCLUDE_TIMESTAMPS=false
LOG_COLORIZE=true

WEB_SERVER_ENABLED=true
WEB_SERVER_PORT=8080
# 0 = a random free port, so every test file boots its own isolated server.
WEB_SERVER_PORT_TEST=0
WEB_SERVER_HOST=localhost
# Tests bind every interface, as deployed services do. `status.test.ts` asserts
# the bound host, so a missing `.env` (which falls back to `localhost`) shows up
# there first.
WEB_SERVER_HOST_TEST=0.0.0.0
APPLICATION_URL="http://localhost:8080"
WEB_SERVER_API_ROUTE="/api"
# Must match the Vite dev server's origin or the browser's CORS preflight fails.
WEB_SERVER_ALLOWED_ORIGINS="http://localhost:3000"
WEB_SERVER_ALLOWED_METHODS="GET, POST, PUT, DELETE, OPTIONS"
# The terminal theme, inlined into every framework-rendered HTML surface: the
# OAuth authorize page. A `.ts` rather than a `.scss` because Bun cannot compile
# Sass; see the comment at the top of the file.
WEB_SERVER_THEME="theme/botholomew-theme.ts"

MCP_SERVER_ENABLED=true
# Set true behind a TLS terminator so OAuth metadata uses the public https
# origin instead of the process's http bind.
# MCP_OAUTH_TRUST_PROXY=true

SESSION_TTL=86400
SESSION_COOKIE_NAME="__session"
# Cross-site only when the UI and API are on different public hosts. Leave unset
# for plain localhost — Secure cookies are not sent over HTTP.
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAME_SITE=None

# Real Postgres, never Docker Compose. Create both databases once:
#   createdb botholomew && createdb botholomew_test
# ...or `bun run workspace:setup`, which creates them and, in a worktree, gives
# this checkout a test database of its own.
DATABASE_URL="postgres://localhost:5432/botholomew"
DATABASE_URL_TEST="postgres://localhost:5432/botholomew_test"
DATABASE_AUTO_MIGRATE=true

# Real Redis, never Docker Compose. Database 1 is reserved for tests — both
# `bun test` and Playwright. `workspace:setup` moves a worktree to one of 2-15.
REDIS_URL="redis://localhost:6379/0"
REDIS_URL_TEST="redis://localhost:6379/1"

RATE_LIMIT_ENABLED=true
# Backend tests hammer the same endpoints from one IP; rate limiting would fail them.
RATE_LIMIT_ENABLED_TEST=false
RATE_LIMIT_WINDOW_MS=60000
# Only actions carrying `RateLimitMiddleware` count against this: signup and
# sign-in. One signup spends two (`user:create` + `session:create`), so the
# framework default of 20/minute is under a dozen signups — fine for one human,
# but the Playwright suite signs up several users and then reads "Rate limit
# exceeded" where it expected "Invalid email or password". The e2e job copies
# this file, so this is the value that keeps that job honest. Staging keeps the
# tighter framework default; render.yaml sets no override.
RATE_LIMIT_UNAUTH_LIMIT=100
RATE_LIMIT_AUTH_LIMIT=200

# AES-256-GCM key, base64 of exactly 32 bytes:
#   openssl rand -base64 32
# The process refuses to boot without a valid one — a silent plaintext fallback
# would put credentials in Postgres unencrypted and report success. This
# development value is generated for this repository and committed on purpose;
# staging's comes from the `botholomew-shared` env var group, which is where it
# must live so web and worker share one key.
SECRETS_ENCRYPTION_KEY="1T1nYT6FrlgeIyT713YpK/Df8dtqmjfxkrCIC2T+cyk="

# The FRONTEND's origin. Deliberately not APPLICATION_URL, which is the backend.
FRONTEND_URL="http://localhost:3000"

# How long audit rows live before the daily `audit:sweep` task deletes them.
# Staging keeps this default; render.yaml sets no override.
AUDIT_RETENTION_DAYS=90

TASKS_ENABLED=true
TASK_PROCESSORS=1
TASK_TIMEOUT=5000
TASK_TIMEOUT_TEST=100

# --- Sentry -----------------------------------------------------------------
# `@keryxjs/sentry` turns itself on when a DSN is present and stays a no-op
# otherwise; no deployment sets one. Leave this empty locally so `bun dev`
# does not ship events; `SENTRY_ENABLED_TEST` is the belt if a developer DSN
# leaks into the test environment. The `status` action sets `tracing = false`
# so health-check traffic stays out of Sentry even if traces are turned on.
SENTRY_DSN=
SENTRY_ENABLED_TEST=false
SENTRY_ENABLE_METRICS=false
SENTRY_ENABLE_LOGS=false
