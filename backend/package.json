{
  "name": "botholomew-backend",
  "version": "2.0.0-alpha.0",
  "description": "Botholomew backend — always-on bot swarms, powered by Keryx",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "keryx": "keryx.ts"
  },
  "scripts": {
    "start": "bun keryx.ts start",
    "dev": "bun --watch keryx.ts start",
    "migrations": "bun run migrations.ts",
    "db:repair-sequences": "bun run scripts/repair-sequences.ts",
    "workspace:setup": "bun run scripts/setup-workspace.ts",
    "test": "bun test",
    "lint": "tsc && biome check .",
    "format": "tsc && biome check --write ."
  },
  "dependencies": {
    "@keryxjs/sentry": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "keryx": "^0.48.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
