{
  "name": "botholomew-workspace",
  "version": "2.0.0-alpha.0",
  "description": "Botholomew — always-on bot swarms",
  "private": true,
  "type": "module",
  "workspaces": ["backend", "frontend", "cli"],
  "trustedDependencies": ["esbuild"],
  "scripts": {
    "dev": "bun run --parallel dev:backend dev:frontend",
    "dev:backend": "bun run --cwd backend dev",
    "dev:frontend": "bun run --cwd frontend dev",
    "lint": "bun run --cwd backend lint && bun run --cwd frontend lint && bun run --cwd cli lint",
    "test": "bun run --cwd backend test && bun run --cwd frontend test && bun run --cwd cli test",
    "test:e2e": "bun run --cwd frontend test:e2e",
    "workspace:setup": "bun run --cwd backend workspace:setup"
  }
}
