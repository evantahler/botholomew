{
  "name": "botholomew",
  "version": "0.27.0",
  "description": "An autonomous AI agent for knowledge work — works your task queue while you sleep.",
  "type": "module",
  "bin": {
    "botholomew": "./src/cli.ts",
    "bothy": "./src/cli.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/evantahler/botholomew.git"
  },
  "scripts": {
    "dev": "bun run src/cli.ts -d .botholomew",
    "dev:demo": "bun run src/cli.ts chat -p 'learn everything you can about me from the connected MCP services and then save what you'\\''ve learned about me to context'",
    "test": "bun test",
    "lint": "tsc --noEmit && biome check .",
    "format": "biome check --write .",
    "build": "bun run scripts/build.ts",
    "capture": "bun run scripts/capture.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.42",
    "@ai-sdk/openai-compatible": "^3.0.37",
    "@evantahler/mcpx": "0.22.3",
    "ai": "^7.0.79",
    "ansis": "^4.3.1",
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "istextorbinary": "^9.5.0",
    "membot": "^0.19.5",
    "nanospinner": "^1.2.2",
    "ollama-ai-provider-v2": "^4.0.1",
    "react": "^19.2.8",
    "run": "^2.1.0",
    "upgradr": "0.4.0",
    "uuid": "^14.0.2",
    "wrap-ansi": "^10.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/uuid": "^11.0.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.13.5",
    "vue": "^3.5.41"
  },
  "trustedDependencies": [
    "protobufjs"
  ]
}
