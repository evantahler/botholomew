# Copy to `.env` for local development: `cp .env.example .env`

# Inlined into the bundle at BUILD time, not read at runtime — changing it
# requires a rebuild, not a restart.
VITE_API_URL=http://localhost:8080

# Vite dev-server port. Must match the backend's WEB_SERVER_ALLOWED_ORIGINS.
PORT=3000

# Both values above are for `bun dev`. The Playwright suite never uses them: it
# starts its own backend and its own dev server on the two ports below, so a suite
# run cannot take the ports a dev server is on.
#
# These defaults are right for a single clone. In a worktree, run
# `bun run workspace:setup` and it rewrites them to a pair derived from this
# checkout, so two worktrees can run their suites at the same time.
E2E_BACKEND_PORT=8081
E2E_FRONTEND_PORT=3001
