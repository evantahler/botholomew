{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "types": ["bun-types"],
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"],
  "comment": "cli-standalone.ts is a build-only entry that dynamically imports the bundled membot/mcpx CLIs; excluded so tsc doesn't type-check their internal asset imports (.md/.mdc/.wasm). Biome still lints it.",
  "exclude": ["node_modules", "src/cli-standalone.ts"]
}
